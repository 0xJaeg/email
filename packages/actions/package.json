{
  "name": "@workspace/actions",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./send-reply": {
      "types": "./src/sendReply.ts",
      "default": "./dist/sendReply.js"
    },
    "./refund-customer": {
      "types": "./src/refundCustomer.ts",
      "default": "./dist/refundCustomer.js"
    },
    "./suppress-contact": {
      "types": "./src/suppressContact.ts",
      "default": "./dist/suppressContact.js"
    },
    "./mailwizz": {
      "types": "./src/mailwizz.ts",
      "default": "./dist/mailwizz.js"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "default": "./dist/crypto.js"
    },
    "./agent-mail": {
      "types": "./src/agent-mail.ts",
      "default": "./dist/agent-mail.js"
    },
    "./send-internal-alert": {
      "types": "./src/sendInternalAlert.ts",
      "default": "./dist/sendInternalAlert.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./api-routing-spec": {
      "types": "./src/api-routing-spec.ts",
      "default": "./dist/api-routing-spec.js"
    }
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "agentmail": "^0.1.19"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
