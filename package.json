{
  "name": "email",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:start": "docker compose up -d redis",
    "db:stop": "docker compose down",
    "sim": "tsx --env-file=.env.local scripts/sim-webhook.ts",
    "sim:batch": "tsx --env-file=.env.local scripts/sim-batch.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svix": "^1.94.0",
    "tsx": "^4.19.0",
    "turbo": "^2.8.17",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
