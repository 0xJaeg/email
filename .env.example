# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<service-role-key>

# Redis (local docker compose)
REDIS_URL=redis://localhost:6379

# Anthropic — classifier + decision
ANTHROPIC_API_KEY=<sk-ant-api03-...>

# Agent Mail — webhook signature verification + sendReply
AGENT_MAIL_WEBHOOK_SECRET=<svix whsec_...>
AGENT_MAIL_API_KEY=<am_us_... from the AgentMail dashboard>

# Integration credentials — AES-256-GCM key for encrypting per-product API keys
# (integration_credentials). Any random string works: openssl rand -base64 32
CREDENTIALS_ENC_KEY=<random 32+ char secret>

# Profit Dashboard — membership/access lookup API (profitdashboard adapter)
PROFITDASHBOARD_API_KEY=<x-api-key from the Profit Dashboard team>

# MailWizz — unsubscribe the customer from all lists on approval (the real opt-out;
# suppression_list stays the internal source of truth, best-effort). Only fires
# when APP_ENV=production; in development the call is skipped.
MAILWIZZ_API_URL=https://portal.remotejobmail.com/api/index.php
MAILWIZZ_API_KEY=<mailwizz api key>

# Internal alerts (optional) — the AgentMail inbox id internal ops alerts (e.g.
# the refund daily-cap notice) are sent FROM. Leave unset to use the oldest
# active inbox. Recipients are configured per-trigger in the app (/settings).
ALERT_FROM_INBOX_ID=

# ticketdesk.ai — read-only eval data pull. Consumed ONLY by
# scripts/pull-ticketdesk.mjs to GET tickets into scripts/fixtures/ for
# sim/eval. Read-only — never used to write to ticketdesk.
TICKETDESK_API_BASE=https://api.ticketdesk.ai/v1/tickets
TICKETDESK_API_KEY=<ticketdesk api key>

# App environment — gates live external mutations (e.g. the MailWizz unsubscribe).
# Unset or "development" = OFF (safe default); set "production" in the prod deploy.
APP_ENV=development

# Ports
PORT=3001