# Aggregated example. Each workspace also has its own .env.example
# documenting only the vars it consumes. Copy to .env.local at the
# matching location (root + per-app) and fill in values.

# ---- Supabase ----
# Used by packages/db; consumed by apps/api, apps/worker, apps/web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Redis (BullMQ broker) ----
REDIS_URL=redis://localhost:6379

# ---- apps/api ----
PORT=3001

# ---- Placeholders for later slices (not used in Foundation) ----
# Slice C — Anthropic classifier / decision
ANTHROPIC_API_KEY=
# Slice B — Agent Mail webhook signature     verification
AGENT_MAIL_WEBHOOK_SECRET=
# Slice E — Agent Mail sendReply
AGENT_MAIL_API_KEY=
